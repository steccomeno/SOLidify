# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local keys and configuration
admin_keypair.json
phantom_private_key.txt
simulated_token_info.json
*.key
*.json  # Remove this line if you track specific JSON files

# IDE files
.idea/
.vscode/

# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Rust/Solana/Anchor specific
.cargo/
.anchor/
Cargo.lock  # Remove this line if your project requires it
target/
**/target/
*.so
*.o
